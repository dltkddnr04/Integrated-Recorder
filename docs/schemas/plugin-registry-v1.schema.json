{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrated-recorder.invalid/schemas/plugin-registry-v1.schema.json",
  "title": "Integrated Recorder Plugin Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plugins"],
  "properties": {
    "schema_version": {"const": 1},
    "plugins": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/plugin"}
    }
  },
  "$defs": {
    "identity": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$"},
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "repository", "channels", "releases"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "repository": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^https://[^/@?#]+/[^?#]+$"},
        "channels": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 3,
          "additionalProperties": false,
          "properties": {
            "stable": {"$ref": "#/$defs/identity"},
            "beta": {"$ref": "#/$defs/identity"},
            "development": {"$ref": "#/$defs/identity"}
          }
        },
        "releases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {"$ref": "#/$defs/release"}
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "protocol_version", "source_commit", "artifacts"],
      "properties": {
        "version": {"$ref": "#/$defs/identity"},
        "protocol_version": {"const": 1},
        "source_commit": {"type": "string", "minLength": 7, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{6,127}$"},
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/artifact"}
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "url", "filename", "size", "sha256"],
      "properties": {
      "os": {"enum": ["linux", "darwin"]},
        "arch": {"enum": ["amd64", "arm64"]},
        "url": {"type": "string", "minLength": 9, "maxLength": 2048, "pattern": "^https://[^/@?#]+/[^#]*$"},
        "filename": {
          "$comment": "Runtime validation also requires this to equal integrated-recorder-adapter-<plugin.id>.",
          "type": "string",
          "minLength": 29,
          "maxLength": 92,
          "pattern": "^integrated-recorder-adapter-[a-z0-9][a-z0-9._-]*$"
        },
        "size": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
